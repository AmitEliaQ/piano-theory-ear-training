#!/bin/sh
# Appends a summary of each commit to the Obsidian Dev Log.
# MUST never fail a commit: every path exits 0.

VAULT_DIR="/Users/amit/obsidian_files/Amit Project/Piano Theory App"
LOG="$VAULT_DIR/02 - Dev Log.md"
REPO_URL="https://github.com/AmitEliaQ/piano-theory-ear-training"

write_log() {
    mkdir -p "$VAULT_DIR" || return 0

    if [ ! -f "$LOG" ]; then
        {
            printf -- '---\ntags: [devlog, automated]\n---\n'
            printf '# Dev Log\n\n'
            printf 'Auto-generated by the `post-commit` git hook.\n\n'
            printf '## Commits\n'
        } > "$LOG" || return 0
    fi

    SHA=$(git log -1 --pretty=%H)
    SHORT=$(git log -1 --pretty=%h)
    SUBJECT=$(git log -1 --pretty=%s)
    AUTHOR=$(git log -1 --pretty=%an)
    DATE=$(git log -1 --pretty=%ad --date=format:'%Y-%m-%d %H:%M')

    # Already logged? (guards amend / rebase re-runs)
    if grep -q "$SHA" "$LOG" 2>/dev/null; then
        return 0
    fi

    FILES=$(git diff-tree --no-commit-id --name-status -r --root HEAD 2>/dev/null \
            | awk '{printf "%s `%s`, ", $1, $2}' | sed 's/, $//')
    [ -z "$FILES" ] && FILES="_(no file changes)_"

    STATS=$(git diff-tree --no-commit-id --numstat -r --root HEAD 2>/dev/null \
            | awk '{a+=$1; d+=$2; n++} END {if (n) printf "%d file(s), +%d/-%d", n, a, d}')
    [ -z "$STATS" ] && STATS="_(no stats)_"

    {
        printf '\n### %s · `%s` — %s\n' "$DATE" "$SHORT" "$SUBJECT"
        printf -- '- **Author:** %s\n' "$AUTHOR"
        printf -- '- **Files:** %s\n' "$FILES"
        printf -- '- **Stats:** %s\n' "$STATS"
        printf -- '- [View on GitHub](%s/commit/%s)\n' "$REPO_URL" "$SHA"
        printf -- '<!-- %s -->\n' "$SHA"
    } >> "$LOG" || return 0

    return 0
}

write_log 2>/dev/null || true
exit 0
